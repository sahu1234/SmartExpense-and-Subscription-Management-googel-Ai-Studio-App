rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny all unlisted paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'email', 'budgetLimit'])
        && data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'budgetLimit', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.email is string
        && data.email.size() > 0 && data.email.size() <= 256
        && data.budgetLimit is number && data.budgetLimit >= 0 && data.budgetLimit <= 100000000
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation for ExpenseItem
    function isValidExpenseItem(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'type', 'amount', 'billingCycle', 'category', 'paymentMethod', 'renewalDate', 'isActive'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'type', 'amount', 'billingCycle', 'category', 'paymentMethod', 'renewalDate', 'isActive', 'autoRenew', 'notes', 'tags', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.type in ['subscription', 'daily']
        && data.amount is number && data.amount >= 0 && data.amount <= 100000000
        && data.billingCycle in ['weekly', 'monthly', 'quarterly', 'yearly']
        && data.category in [
          'Entertainment', 'Cloud & SaaS', 'Food & Dining', 'Utilities & Bills',
          'Fitness & Health', 'Shopping', 'Transport', 'Work & Productivity',
          'Education', 'Personal'
        ]
        && data.paymentMethod in ['UPI', 'Credit Card', 'Debit Card', 'Net Banking', 'Auto-Debit']
        && data.renewalDate is string && data.renewalDate.size() <= 32
        && data.isActive is bool
        && (!('autoRenew' in data) || data.autoRenew is bool)
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 10))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // User Profile collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Users cannot list other user profiles
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().userId == existing().userId;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Private Expenses Subcollection for each user
      match /expenses/{expenseId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(expenseId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(expenseId)
          && isValidExpenseItem(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(expenseId)
          && isValidExpenseItem(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(expenseId);
      }
    }
  }
}
